# ── Password-reset link base URLs ────────────────────────────────
# Each admin portal has its OWN domain in the deployed envs, but all three are
# served from ONE build behind ONE nginx, so the React route prefix still
# applies on every domain. The API therefore needs base URL *and* keeps the
# prefix: <SUPERADMIN_URL>/super-admin/..., <ADMIN_URL>/admin/..., <TEAM_URL>/...
#
# Locally all three portals live on localhost:8888, so leave SUPERADMIN_URL and
# TEAM_URL unset — both fall back to ADMIN_URL automatically.
ADMIN_URL=http://localhost:8888
# SUPERADMIN_URL=
# TEAM_URL=

# Storefront (prakriti_Frontend) — ONE domain; retailer sits at /retailer and
# customer at the root. Not the same as BASE_URL above (the R2 asset CDN).
STOREFRONT_URL=http://localhost:8080

# Deployed values — set these on the server, do NOT commit them:
#
#   DEV   SUPERADMIN_URL=https://dev.super.prakriti.one
#         ADMIN_URL=https://dev.admin.prakriti.one
#         TEAM_URL=https://dev.team.prakriti.one
#         STOREFRONT_URL=https://dev.prakriti.one
#
#   TEST  SUPERADMIN_URL=https://test.super.prakriti.one
#         ADMIN_URL=https://test.admin.prakriti.one
#         TEAM_URL=https://test.team.prakriti.one
#         STOREFRONT_URL=https://test.prakriti.one        <-- UNCONFIRMED
#
#   PROD  SUPERADMIN_URL=https://super.prakriti.one
#         ADMIN_URL=https://admin.prakriti.one
#         TEAM_URL=https://team.prakriti.one
#         STOREFRONT_URL=https://prakriti.one             <-- UNCONFIRMED
#
# NOTE: prakriti_Admin/nginx.conf currently lists server_name as
# "super.test.prakriti.one admin.test.prakriti.one team.test.prakriti.one",
# which does NOT match the test domains above (test.super.* etc). Whichever is
# wrong, nginx must match or the domain will not route.

# Password reset token lifetime (minutes)
RESET_TOKEN_EXPIRES_MINUTES=60
